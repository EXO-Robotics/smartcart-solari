{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v2/solari/basket-research-result.schema.json",
  "title": "BasketResearchResultV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "requestID", "demoID", "retailerID", "completedAt", "executionMode", "status",
    "observations", "decisions", "basket", "optimizer", "provenance", "trust"
  ],
  "properties": {
    "schemaVersion": { "const": "solari-shopping-research-result-v2" },
    "requestID": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "demoID": { "const": "owned-demo-grocer-basket-v2" },
    "retailerID": { "const": "smartcart-demo-grocer" },
    "completedAt": { "type": "string", "format": "date-time" },
    "executionMode": { "const": "live" },
    "status": { "enum": ["complete", "partial", "unavailable"] },
    "observations": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "https://schemas.smartcart.app/v2/solari/retailer-observation.schema.json" }
    },
    "decisions": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "https://schemas.smartcart.app/v2/solari/basket-decision.schema.json" }
    },
    "basket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "observedSubtotal", "currency", "pricedLineCount", "missingPriceLineCount", "unmatchedRequirementCount"],
      "properties": {
        "completeness": { "enum": ["complete", "partial"] },
        "observedSubtotal": { "type": ["number", "null"], "minimum": 0, "maximum": 100000 },
        "currency": { "type": ["string", "null"], "enum": ["USD", null] },
        "pricedLineCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "missingPriceLineCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "unmatchedRequirementCount": { "type": "integer", "minimum": 0, "maximum": 3 }
      },
      "allOf": [
        {
          "if": { "properties": { "observedSubtotal": { "type": "number" } }, "required": ["observedSubtotal"] },
          "then": { "properties": { "currency": { "const": "USD" } } },
          "else": { "properties": { "currency": { "type": "null" } } }
        }
      ]
    },
    "optimizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "algorithmVersion", "independentlyVerified"],
      "properties": {
        "method": { "const": "solari-sandbox" },
        "algorithmVersion": { "const": "smallest-sufficient-package-v1" },
        "independentlyVerified": { "const": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "sandbox", "fixtureReplay", "resourceCleanup", "accessBoundary"],
      "properties": {
        "browser": { "const": "solari-browser" },
        "sandbox": { "const": "solari-sandbox" },
        "fixtureReplay": { "const": false },
        "resourceCleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["browser", "sandbox"],
          "properties": {
            "browser": { "const": "enforced-before-response" },
            "sandbox": { "const": "enforced-before-response" }
          }
        },
        "accessBoundary": { "const": "apple-app-attest" }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priceClaim", "accountAccessed", "cartModified", "checkoutAutomated", "userControlsHandoff", "limitations"],
      "properties": {
        "priceClaim": { "const": "observed-visible-price-not-guaranteed" },
        "accountAccessed": { "const": false },
        "cartModified": { "const": false },
        "checkoutAutomated": { "const": false },
        "userControlsHandoff": { "const": true },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  }
}
