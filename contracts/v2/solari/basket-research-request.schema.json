{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v2/solari/basket-research-request.schema.json",
  "title": "BasketResearchRequestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestID", "demoID", "submittedAt", "retailerID", "executionMode", "storeReference", "requirements"],
  "properties": {
    "schemaVersion": { "const": "solari-shopping-research-request-v2" },
    "requestID": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,69}$" },
    "demoID": { "const": "owned-demo-grocer-basket-v2" },
    "submittedAt": { "type": "string", "format": "date-time" },
    "retailerID": { "const": "smartcart-demo-grocer" },
    "executionMode": { "const": "live" },
    "storeReference": { "const": "smartcart-demo-grocer-owned-catalog-v1" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ingredientID", "name", "requestedQuantityText", "requiredQuantity", "unit", "candidateProductIDs"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "ingredientID": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "requestedQuantityText": { "type": "string", "minLength": 1, "maxLength": 160 },
        "requiredQuantity": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
          "unit": { "enum": ["oz", "lb", "count"] },
          "candidateProductIDs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "enum": ["10414680", "10534084", "623835750", "10452414", "10307238", "47088917"] }
          }
        }
      }
    }
  }
}
