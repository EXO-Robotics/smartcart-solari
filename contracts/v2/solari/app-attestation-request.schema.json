{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v2/solari/app-attestation-request.schema.json",
  "title": "SolariAppAttestationRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "challengeID", "keyID", "attestationObject"],
  "properties": {
    "schemaVersion": { "const": "solari-app-attestation-request-v1" },
    "challengeID": { "type": "string", "format": "uuid" },
    "keyID": { "$ref": "#/$defs/canonicalStandardBase64KeyID" },
    "attestationObject": {
      "type": "string",
      "minLength": 4,
      "maxLength": 43692,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "$defs": {
    "canonicalStandardBase64KeyID": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^(?:[A-Za-z0-9+/]{4}){10}[A-Za-z0-9+/]{3}=$"
    }
  }
}
