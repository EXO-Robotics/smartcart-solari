{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v2/solari/app-attest-research-envelope.schema.json",
  "title": "SolariAppAttestResearchEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "challengeID", "keyID", "assertionObject", "payloadBase64"],
  "properties": {
    "schemaVersion": { "const": "solari-app-attest-research-envelope-v1" },
    "challengeID": { "type": "string", "format": "uuid" },
    "keyID": { "$ref": "#/$defs/canonicalStandardBase64KeyID" },
    "assertionObject": {
      "type": "string",
      "minLength": 4,
      "maxLength": 21848,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "payloadBase64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 43692,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  },
  "$defs": {
    "canonicalStandardBase64KeyID": {
      "type": "string",
      "minLength": 44,
      "maxLength": 44,
      "pattern": "^(?:[A-Za-z0-9+/]{4}){10}[A-Za-z0-9+/]{3}=$"
    }
  }
}
