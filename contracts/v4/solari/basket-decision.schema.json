{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v4/solari/basket-decision.schema.json",
  "title": "BasketDecisionV4",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "requirementID", "observationID", "retailerProductID", "packageCount", "requiredQuantity", "coveredQuantity", "quantityUnit", "surplusQuantity", "relativeSurplus", "lineTotal", "currency", "proteinGramsPerDollar", "substitutionNote", "rationale", "confidence", "ambiguityReasons"],
  "properties": {
    "schemaVersion": { "const": "basket-decision-v4" },
    "requirementID": { "type": "string", "format": "uuid" },
    "observationID": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,119}$" },
    "retailerProductID": { "type": "string", "pattern": "^dg4-[a-z0-9-]{1,80}$" },
    "packageCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "requiredQuantity": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 },
    "coveredQuantity": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000000 },
    "quantityUnit": { "enum": ["gram", "milliliter", "count"] },
    "surplusQuantity": { "type": "number", "minimum": 0, "maximum": 100000000 },
    "relativeSurplus": { "type": "number", "minimum": 0, "maximum": 10000000 },
    "lineTotal": { "type": "number", "minimum": 0, "maximum": 100000 },
    "currency": { "const": "USD" },
    "proteinGramsPerDollar": { "type": "null" },
    "substitutionNote": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 },
    "rationale": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
    "confidence": { "enum": ["high", "medium", "low"] },
    "ambiguityReasons": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
  }
}
