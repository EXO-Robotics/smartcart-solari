{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v1/nutrition/recipe-nutrition-request.schema.json",
  "title": "Recipe nutrition request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "data"],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/schemaVersion"
    },
    "requestId": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/requestId"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipeId", "title", "servings", "ingredients"],
      "properties": {
        "recipeId": {
          "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/entityId"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "servings": { "type": "number", "exclusiveMinimum": 0 },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "https://schemas.smartcart.app/v1/ingredient/ingredient-input.schema.json"
          }
        }
      }
    }
  }
}
