{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v1/nutrition/nutrition-resolution.schema.json",
  "title": "Ingredient nutrition resolution envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resolverVersion", "requestId", "data"],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/schemaVersion"
    },
    "resolverVersion": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/resolverVersion"
    },
    "requestId": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/requestId"
    },
    "data": {
      "$ref": "#/$defs/resolutionData"
    }
  },
  "$defs": {
    "resolutionData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingredientId",
        "identityKey",
        "massGrams",
        "nutrition",
        "confidence",
        "evidence",
        "issues"
      ],
      "properties": {
        "ingredientId": {
          "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/entityId"
        },
        "identityKey": {
          "type": ["string", "null"],
          "pattern": "^smartcart-food:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "massGrams": {
          "oneOf": [
            { "$ref": "https://schemas.smartcart.app/v1/common/numeric-estimate.schema.json" },
            { "type": "null" }
          ]
        },
        "nutrition": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["energyKilocalories", "proteinGrams"],
              "properties": {
                "energyKilocalories": {
                  "$ref": "https://schemas.smartcart.app/v1/common/numeric-estimate.schema.json"
                },
                "proteinGrams": {
                  "$ref": "https://schemas.smartcart.app/v1/common/numeric-estimate.schema.json"
                }
              }
            },
            { "type": "null" }
          ]
        },
        "confidence": {
          "$ref": "https://schemas.smartcart.app/v1/common/resolution-confidence.schema.json"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.smartcart.app/v1/common/resolution-evidence.schema.json"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.smartcart.app/v1/common/resolution-issue.schema.json"
          }
        }
      }
    }
  }
}
