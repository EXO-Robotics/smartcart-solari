{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v1/nutrition/meal-prep-nutrition-request.schema.json",
  "title": "Meal Prep nutrition request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "data"],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/schemaVersion"
    },
    "requestId": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/requestId"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mealPlanId", "recipes"],
      "properties": {
        "mealPlanId": {
          "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/entityId"
        },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "https://schemas.smartcart.app/v1/nutrition/recipe-nutrition-request.schema.json#/properties/data"
          }
        }
      }
    }
  }
}
