{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v1/nutrition/meal-prep-nutrition-estimate.schema.json",
  "title": "Meal Prep nutrition estimate envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resolverVersion", "requestId", "data"],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/schemaVersion"
    },
    "resolverVersion": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/resolverVersion"
    },
    "requestId": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/requestId"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mealPlanId",
        "recipeEstimates",
        "totals",
        "totalServings",
        "weightedAveragePerServing",
        "confidence",
        "evidence",
        "issues"
      ],
      "properties": {
        "mealPlanId": {
          "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/entityId"
        },
        "recipeEstimates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.smartcart.app/v1/nutrition/recipe-nutrition-estimate.schema.json#/$defs/recipeData"
          }
        },
        "totals": {
          "$ref": "https://schemas.smartcart.app/v1/nutrition/recipe-nutrition-estimate.schema.json#/$defs/nutritionPair"
        },
        "totalServings": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "weightedAveragePerServing": {
          "$ref": "https://schemas.smartcart.app/v1/nutrition/recipe-nutrition-estimate.schema.json#/$defs/nutritionPair"
        },
        "confidence": {
          "$ref": "https://schemas.smartcart.app/v1/common/resolution-confidence.schema.json"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.smartcart.app/v1/common/resolution-evidence.schema.json"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.smartcart.app/v1/common/resolution-issue.schema.json"
          }
        }
      }
    }
  }
}
