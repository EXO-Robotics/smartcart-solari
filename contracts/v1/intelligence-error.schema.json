{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v1/intelligence-error.schema.json",
  "title": "Trip Intelligence error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resolverVersion", "requestId", "error"],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/schemaVersion"
    },
    "resolverVersion": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/resolverVersion"
    },
    "requestId": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/requestId"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "issues"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 100 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.smartcart.app/v1/common/resolution-issue.schema.json"
          }
        }
      }
    }
  }
}
