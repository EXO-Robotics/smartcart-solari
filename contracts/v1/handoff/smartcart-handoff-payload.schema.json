{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v1/handoff/smartcart-handoff-payload.schema.json",
  "title": "Frozen SmartCart trip handoff payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resolverVersion", "requestId", "data"],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/schemaVersion"
    },
    "resolverVersion": { "const": "smartcart-handoff-v1" },
    "requestId": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/requestId"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "audience",
        "payloadDigest",
        "issuedAt",
        "expiresAt",
        "recipes"
      ],
      "properties": {
        "claimId": {
          "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/entityId"
        },
        "audience": { "const": "smartcart-ios" },
        "payloadDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceType",
              "recipeText",
              "analysis",
              "quantityReviewIngredientIds"
            ],
            "properties": {
              "sourceType": {
                "type": "string",
                "enum": ["text", "image_transcription"]
              },
              "recipeText": { "type": "string", "minLength": 1, "maxLength": 50000 },
              "analysis": {
                "allOf": [
                  {
                    "$ref": "https://schemas.smartcart.app/v1/recipe/recipe-analysis-result.schema.json"
                  },
                  {
                    "type": "object",
                    "required": ["data"],
                    "properties": {
                      "data": {
                        "type": "object",
                        "required": ["servings"],
                        "properties": {
                          "servings": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 48
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "quantityReviewIngredientIds": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/entityId"
                }
              }
            }
          }
        }
      }
    }
  }
}
