{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v1/solari/basket-research-result.schema.json",
  "title": "BasketResearchResultV1",
  "type": "object", "additionalProperties": false,
  "required": [
    "schemaVersion", "requestID", "demoID", "retailerID", "completedAt", "executionMode", "status",
    "observations", "decisions", "basket", "optimizer", "provenance", "trust"
  ],
  "properties": {
    "schemaVersion": { "const": "solari-shopping-research-result-v1" },
    "requestID": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "demoID": { "const": "chicken-parmesan-pasta-v1" },
    "retailerID": { "enum": ["walmart", "smartcart-demo-grocer"] },
    "completedAt": { "type": "string", "format": "date-time" },
    "executionMode": { "enum": ["recorded_fixture", "live"] },
    "status": { "enum": ["complete", "partial", "unavailable"] },
    "observations": { "type": "array", "maxItems": 6, "items": { "$ref": "https://schemas.smartcart.app/v1/solari/retailer-observation.schema.json" } },
    "decisions": { "type": "array", "maxItems": 3, "items": { "$ref": "https://schemas.smartcart.app/v1/solari/basket-decision.schema.json" } },
    "basket": {
      "type": "object", "additionalProperties": false,
      "required": ["completeness", "observedSubtotal", "currency", "pricedLineCount", "missingPriceLineCount", "unmatchedRequirementCount"],
      "properties": {
        "completeness": { "enum": ["complete", "partial"] },
        "observedSubtotal": { "type": ["number", "null"], "minimum": 0, "maximum": 100000 },
        "currency": { "type": ["string", "null"], "enum": ["USD", null] },
        "pricedLineCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "missingPriceLineCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "unmatchedRequirementCount": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "optimizer": {
      "type": "object", "additionalProperties": false, "required": ["method", "algorithmVersion", "independentlyVerified"],
      "properties": {
        "method": { "enum": ["smartcart-deterministic-fixture-replay", "solari-sandbox"] },
        "algorithmVersion": { "const": "smallest-sufficient-package-v1" },
        "independentlyVerified": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["browser", "sandbox", "fixtureReplay", "resourceCleanup"],
      "properties": {
        "browser": { "enum": ["not-run-fixture-replay", "solari-browser"] },
        "sandbox": { "enum": ["not-run-fixture-replay", "solari-sandbox"] },
        "fixtureReplay": { "type": "boolean" },
        "resourceCleanup": {
          "type": "object", "additionalProperties": false, "required": ["browser", "sandbox"],
          "properties": {
            "browser": { "enum": ["not-run-fixture-replay", "enforced-before-response"] },
            "sandbox": { "enum": ["not-run-fixture-replay", "enforced-before-response"] }
          }
        }
      }
    },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["priceClaim", "accountAccessed", "cartModified", "checkoutAutomated", "userControlsHandoff", "limitations"],
      "properties": {
        "priceClaim": { "enum": ["recorded-fixture-not-live", "observed-visible-price-not-guaranteed"] },
        "accountAccessed": { "const": false },
        "cartModified": { "const": false },
        "checkoutAutomated": { "const": false },
        "userControlsHandoff": { "const": true },
        "limitations": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 400 } }
      }
    }
  }
}
