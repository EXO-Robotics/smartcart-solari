{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v1/common/resolution-issue.schema.json",
  "title": "Resolution issue",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "severity", "message", "evidenceIds"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "severity": {
      "type": "string",
      "enum": ["blocking", "review", "informational"]
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 },
    "field": { "type": ["string", "null"], "maxLength": 100 },
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "uniqueItems": true
    }
  }
}
