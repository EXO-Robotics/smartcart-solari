{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smartcart.app/v1/recipe/recipe-analysis-request.schema.json",
  "title": "Recipe text analysis request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "data"],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/schemaVersion"
    },
    "requestId": {
      "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/requestId"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipeId", "title", "servings", "recipeText"],
      "properties": {
        "recipeId": {
          "$ref": "https://schemas.smartcart.app/v1/common/contract-fields.schema.json#/$defs/entityId"
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "servings": { "type": "number", "exclusiveMinimum": 0 },
        "recipeText": { "type": "string", "minLength": 1, "maxLength": 50000 }
      }
    }
  }
}
