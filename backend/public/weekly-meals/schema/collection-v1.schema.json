{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content.smartcart.app/weekly-meals/schema/collection-v1.schema.json",
  "title": "SmartCart Weekly Meals collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "publishedAt",
    "collection",
    "recipes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "revision": { "type": "integer", "minimum": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentSchemaVersion",
        "title",
        "weekStartDate",
        "weekEndDateExclusive",
        "entries"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "contentSchemaVersion": { "const": 1 },
        "title": { "type": "string", "minLength": 1 },
        "weekStartDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "weekEndDateExclusive": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "entries": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "type": "object" }
        },
        "promotionalMessage": { "type": ["string", "null"] }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "contentVersion",
          "title",
          "shortDescription",
          "defaultServings",
          "servingDescription",
          "ingredients",
          "instructions",
          "substitutions",
          "metadata"
        ]
      }
    }
  }
}
