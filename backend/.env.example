# SmartCart local/demo backend only. Never place real credentials in this file.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local/demo controls. These are not production persistence or authentication.
SESSION_TTL_SECONDS=3600
OAUTH_STATE_TTL_SECONDS=600
CACHE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
MAX_BODY_BYTES=262144
RECIPE_PAGE_TIMEOUT_MS=10000
RECIPE_PAGE_MAX_BYTES=2097152
RECIPE_PAGE_MAX_REDIRECTS=5

# Food identity lookup. Use a real app/contact URL in the identifying User-Agent.
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=SmartCartBeta/0.4 (https://github.com/EXO-Robotics)
BARCODE_LOOKUP_TIMEOUT_MS=5000
BARCODE_POSITIVE_CACHE_TTL_SECONDS=86400
BARCODE_NEGATIVE_CACHE_TTL_SECONDS=900
BARCODE_PROVIDER_RATE_LIMIT_PER_MINUTE=12

# Server-only USDA FoodData Central access. Request a key from data.gov.
# Never ship this value in the iOS app or commit a real key.
# USDA_FDC_API_KEY=replace-with-server-side-key
USDA_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_FDC_TIMEOUT_MS=8000
USDA_FDC_CACHE_TTL_SECONDS=86400
USDA_FDC_CACHE_MAX_ENTRIES=512
TRIP_INTELLIGENCE_RATE_LIMIT_PER_MINUTE=30
MCP_RATE_LIMIT_PER_MINUTE=60

# Short-lived bounded-use ChatGPT -> SmartCart native handoff. The bearer is
# replayable until expiry; its fragment stays out of HTTP requests and access
# logs: https://smartcart.app/t#<token>.
SMARTCART_HANDOFF_BASE_URL=https://smartcart.app
SMARTCART_HANDOFF_TTL_SECONDS=600
SMARTCART_HANDOFF_MAX_PAYLOAD_BYTES=131072
SMARTCART_HANDOFF_MAX_TOKEN_CHARACTERS=24000
SMARTCART_HANDOFF_CLAIM_RATE_LIMIT_PER_MINUTE=30
SMARTCART_HANDOFF_TOKEN_RATE_LIMIT_PER_MINUTE=6

# Production fails closed without an independent 32-byte base64/base64url key.
# Generate outside source control, store only as a Sensitive Vercel variable.
# HANDOFF_TOKEN_SECRET=replace-with-32-random-bytes-encoded-as-base64url

# Placeholder identifiers only. No provider secrets are used or accepted.
OAUTH_DEMO_CLIENT_ID=smartcart-local-demo-client
OAUTH_DEMO_REDIRECT_URI=http://127.0.0.1:8787/v1/oauth/demo/callback
AFFILIATE_DEMO_CAMPAIGN=smartcart-local-demo

# Instacart Developer Platform handoff. Keep the API key on this server only.
# Development: https://connect.dev.instacart.tools
# Production:  https://connect.instacart.com
INSTACART_API_BASE_URL=https://connect.dev.instacart.tools
# INSTACART_API_KEY=replace-with-server-side-key
INSTACART_TIMEOUT_MS=10000
INSTACART_HANDOFF_CACHE_TTL_SECONDS=86400

# Explicit non-live development fallback. When set, no Instacart API request is made,
# the response provider is instacart-demo, and this setting is rejected in production.
# INSTACART_DEMO_HANDOFF_URL=https://demo.example/smartcart-handoff
