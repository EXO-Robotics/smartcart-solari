{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 35
    },
    "api/intelligence.js": {
      "maxDuration": 35
    },
    "api/mcp.js": {
      "maxDuration": 35
    },
    "api/handoff.js": {
      "maxDuration": 10
    },
    "api/solari.js": {
      "maxDuration": 60,
      "supportsCancellation": true,
      "includeFiles": "{../contracts/**,node_modules/patchright-core/**}"
    }
  },
  "routes": [
    {
      "src": "/\\.well-known/apple-app-site-association",
      "methods": ["GET", "HEAD"],
      "dest": "/.well-known/apple-app-site-association.json",
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "public, max-age=300",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/health",
      "methods": ["GET", "HEAD"],
      "dest": "/api/index.js?route=health"
    },
    {
      "src": "/v1/barcodes/(?<gtin>\\d{8,14})",
      "methods": ["GET"],
      "dest": "/api/index.js?route=barcode&gtin=$gtin"
    },
    {
      "src": "/v1/intelligence/nutrition/recipes/estimate",
      "methods": ["POST"],
      "dest": "/api/intelligence.js?route=recipe-nutrition"
    },
    {
      "src": "/mcp",
      "methods": ["POST"],
      "dest": "/api/mcp.js?route=mcp"
    },
    {
      "src": "/v1/handoffs/claim",
      "methods": ["POST"],
      "dest": "/api/handoff.js?route=claim"
    },
    {
      "src": "/v1/solari/research",
      "methods": ["POST"],
      "dest": "/api/solari.js?route=research"
    },
    {
      "src": "/v1/solari/access/challenges",
      "methods": ["POST"],
      "dest": "/api/solari.js?route=challenge"
    },
    {
      "src": "/v1/solari/access/attestations",
      "methods": ["POST"],
      "dest": "/api/solari.js?route=attestation"
    },
    {
      "src": "/dev/v1/solari/research",
      "methods": ["POST"],
      "dest": "/api/solari.js?route=dev-research"
    },
    {
      "src": "/dev/v1/solari/access/challenges",
      "methods": ["POST"],
      "dest": "/api/solari.js?route=dev-challenge"
    },
    {
      "src": "/dev/v1/solari/access/attestations",
      "methods": ["POST"],
      "dest": "/api/solari.js?route=dev-attestation"
    },
    {
      "src": "/t",
      "methods": ["GET", "HEAD"],
      "dest": "/t/index.html"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ]
}
